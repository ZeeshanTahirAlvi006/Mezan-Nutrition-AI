{
  "name": "nutri_guide_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "install-all": "npm install && npm install --prefix backend",
    "build": "vite build",
    "dev:frontend": "vite --port 5713",
    "dev:backend": "npm run dev --prefix backend",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "start": "node backend/server.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
